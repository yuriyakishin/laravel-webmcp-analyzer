{
    "name": "yu-laravel/webmcp-analyzer",
    "description": "Laravel Livewire tool that checks how a page exposes WebMCP tools to AI agents.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "webmcp",
        "mcp",
        "ai-agents"
    ],
    "homepage": "https://github.com/yuriyakishin/laravel-webmcp-analyzer",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuriy Akishin",
            "email": "yuriy.akishin@gmail.com",
            "homepage": "https://yu.net.ua"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "yu-laravel/web-tools-core": "^1.0.2"
    },
    "autoload": {
        "psr-4": {
            "Yu\\WebMcpAnalyzer\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Yu\\WebMcpAnalyzer\\WebMcpAnalyzerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
